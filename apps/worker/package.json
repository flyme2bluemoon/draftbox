{
    "name": "@draftbox/worker",
    "private": true,
    "type": "module",
    "scripts": {
        "build:deps": "pnpm --filter @draftbox/contracts run build",
        "build": "pnpm run build:deps && wrangler deploy --dry-run --outdir dist",
        "check": "tsc --noEmit",
        "deploy": "pnpm run build:deps && wrangler deploy",
        "dev": "pnpm run build:deps && wrangler dev",
        "test": "pnpm run build:deps && vitest run",
        "migration": "pnpm exec wrangler d1 migrations apply draftbox --remote"
    },
    "dependencies": {
        "@draftbox/contracts": "workspace:*",
        "hono": "^4.13.3",
        "jose": "^6.2.9"
    }
}
