{
    "$schema": "../../node_modules/wrangler/config-schema.json",
    "name": "draftbox",
    "main": "src/index.ts",
    "compatibility_date": "2026-08-15",
    "workers_dev": true,
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "draftbox",
            "database_id": "7ca1c48b-a3c4-4d9f-9627-0b7e7d493e70",
            "migrations_dir": "migrations"
        }
    ],
    "r2_buckets": [
        {
            "binding": "ARTIFACTS",
            "bucket_name": "draftbox-artifacts"
        }
    ],
    "vars": {
        "WORKOS_AUDIENCE": "client_01M0N6SYT5X1HMS3PY81R2XZPB",
        "WORKOS_ISSUER": "https://palatial-chess-26-staging.authkit.app",
        "WORKOS_JWKS_URL": "https://palatial-chess-26-staging.authkit.app/oauth2/jwks"
    }
}
