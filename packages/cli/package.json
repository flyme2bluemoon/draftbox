{
  "name": "draftbox",
  "version": "0.1.0",
  "type": "module",
  "description": "Manage and share versioned HTML artifacts with Draftbox.",
  "engines": {
    "node": ">=22.11"
  },
  "bin": {
    "draftbox": "dist/index.js"
  },
  "files": [
    "dist/index.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyme2bluemoon/draftbox.git",
    "directory": "packages/cli"
  },
  "scripts": {
    "build": "node ./build.mjs",
    "check": "tsc --noEmit",
    "cli": "node dist/index.js",
    "dev": "DRAFTBOX_API_URL=\"http://localhost:8787\" pnpm run cli",
    "prepack": "pnpm run build",
    "test": "tsc && node --test --experimental-strip-types test/**/*.test.ts"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@draftbox/contracts": "workspace:*",
    "esbuild": "^0.25.12"
  }
}
